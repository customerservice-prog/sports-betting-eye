# Sports Eye data mode
SPORTS_DATA_MODE=demo

# PostgreSQL persistence. Railway production should use a service reference:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
PG_POOL_MAX=5

# Background synthetic exploration worker
BACKGROUND_EXPLORATION_ENABLED=false
EXPLORATION_BATCH_SIZE=5000
EXPLORATION_BATCHES_PER_RUN=20

# Add provider credentials only when connecting a real feed.
# Never commit actual secret values.
SPORTSDATAIO_API_KEY=
SPORTRADAR_API_KEY=
ODDS_API_KEY=
